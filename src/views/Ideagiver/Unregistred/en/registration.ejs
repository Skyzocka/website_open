<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration</title>
    <!-- Link to your main.css file -->
	<link rel="stylesheet" type="text/css" href="/css1/main.css">
</head>

<body>

