<ul>
    <font face="showcard gothic">
      <li><a id="homeButton" href="/">Abc</a></li>
      <li><a href="/en/registration">Registration</a></li>
      <li style="float:right"><a class="active">language: <select id="languageSelect" name="language">
        <option value="language_en">English</option>
        <option value="language_de">Deutsch</option>
      </select></a></li>
      <li style="float:right">
        <a class="anmeldung">
            <p class="no-hover"><input type="text" name="email" value="" size="30" maxlength="30" placeholder="E-Mail"></p>
            <p class="no-hover"><input type="password" name="password" value="" size="30" maxlength="30" placeholder="Passwort"></p>
        </a>
    </li>
        </font>
    </ul>

<div class="registration-container">
    <div class="registration-form">
        <h3 class="registration-heading">Register</h3>
        <h4>
            <!-- Here comes the registration form, that is transferred to "app.js" -->
            <form action="/auth/register" method="POST">
                <p>E-Mail: <input type="email" name="email" placeholder="Email" value="" size="30" maxlength="50"> </p>
                <p>Password: <input type="password" name="password" value="" size="30" maxlength="256" placeholder="Password"> </p>
                Birthday: <input type="date" name="birthdate" id="birthdate">
                Country: <select name="Land">
                    <option value="Austria">Austria</option>
                    <option value="Switzerland">Switzerland</option>
                    <option value="Germany">Germany</option>
                    <option value="USA">USA</option>
                    <option value="UK">United Kingdom</option>
                    <option value="Canada">Canada</option>
                    <option value="Australia">Australia</option>
                    <option value="New Zealand">New Zealand</option>
                    <option value="South Africa">South Africa</option>
                </select>
                <input type="submit" value="Register" class="registration-submit">
            </form>
        </h4>
    </div>
</div>
</body>

</html>